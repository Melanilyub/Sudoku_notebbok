      "7 . . . 2 . . . 6\n",
      ". 6 . . . . 2 8 .\n",
      ". . . 4 1 9 . . 5\n",
      ". . . . 8 . . 7 9\n"
     ]
    }
   ],
   "source": [
    "board = [\n",
    "[5,3,0,0,7,0,0,0,0],\n",
    "[6,0,0,1,9,5,0,0,0],\n",
    "[0,9,8,0,0,0,0,6,0],\n",
    "[8,0,0,0,6,0,0,0,3],\n",
    "[4,0,0,8,0,3,0,0,1],\n",
    "[7,0,0,0,2,0,0,0,6],\n",
    "[0,6,0,0,0,0,2,8,0],\n",
    "[0,0,0,4,1,9,0,0,5],\n",
    "[0,0,0,0,8,0,0,7,9]\n",
    "]\n",
    "\n",
    "def print_board(board):\n",
    "    for row in board:\n",
    "        print(\" \".join(str(num) if num != 0 else \".\" for num in row))\n",
    "print_board(board)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "c52dc1ee-75cc-4135-a925-ac1747d2950f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5 3 0 | 0 7 0 | 0 0 0\n",
      "6 0 0 | 1 9 5 | 0 0 0\n",
      "0 9 8 | 0 0 0 | 0 6 0\n",
      "- - - - - - - - - - -\n",
      "8 0 0 | 0 6 0 | 0 0 3\n",
      "4 0 0 | 8 0 3 | 0 0 1\n",
      "7 0 0 | 0 2 0 | 0 0 6\n",
      "- - - - - - - - - - -\n",
      "0 6 0 | 0 0 0 | 2 8 0\n",
      "0 0 0 | 4 1 9 | 0 0 5\n",
      "0 0 0 | 0 8 0 | 0 7 9\n"
     ]
    }
   ],
   "source": [
    "def new_print(board):\n",
    "\n",
    "    for i in range(9):\n",
    "\n",
    "        if i % 3 == 0 and i != 0:\n",
    "            print(\"- - - - - - - - - - -\")\n",
    "\n",
    "        for j in range(9):\n",
    "\n",
    "            if j % 3 == 0 and j != 0:\n",
    "                print(\"| \", end=\"\")\n",
    "\n",
    "            if j == 8:\n",
    "                print(board[i][j])\n",
    "            else:\n",
    "                print(str(board[i][j]) + \" \", end=\"\")\n",
    "\n",
    "new_print(board)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "91a25d3a-c270-41b1-a620-023f79c9d385",
   "metadata": {},
   "outputs": [],
   "source": [
    "def is_valid(board, row, column, num):\n",
    "\n",
    "    if num in board[row]:\n",
    "        return False\n",
    "\n",
    "    for i in range(9):\n",
    "        if board[i][column] == num:\n",
    "            return False\n",
    "\n",
    "    beginning_row = (row // 3) * 3\n",
    "    beginning_column = (column // 3) * 3\n",
    "\n",
    "    for i in range(3):\n",
    "        for j in range(3):\n",
    "            if board[begininng_row+i][beginning_column+j] == num:\n",
    "                return False\n",
    "\n",
    "    return True"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "3b7c34bb-3d36-44ee-9a92-02375c6ec238",
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_empty(board):\n",
    "\n",
    "    for i in range(9):\n",
    "        for j in range(9):\n",
    "            if board[i][j] == 0:\n",
    "                return (i, j)\n",
    "\n",
    "    return None"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "d4312ba2-1bd6-499c-a574-3102e591ea50",
   "metadata": {},
   "outputs": [],
   "source": [
    "def solve(board):\n",
    "\n",
    "    empty = find_empty(board)\n",
    "\n",
    "    if not empty:\n",
    "        return True\n",
    "\n",
    "    row, column = empty\n",
    "\n",
    "    for num in range(1,10):\n",
    "\n",
    "        if is_valid(board,row,column,num):\n",
    "\n",
    "            board[row][column] = num\n",
    "\n",
    "            if solve(board):\n",
    "                return True\n",
    "\n",
    "            board[row][column] = 0\n",
    "\n",
    "    return False"
   ]
  },
